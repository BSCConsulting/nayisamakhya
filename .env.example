# Supabase (optional — without these, mandal hubs use static src/lib/data/mandals.ts)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Preferred for scripts/seed-officers.mjs (upserts). Falls back to anon key if unset.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
